.venv/
__pycache__/
*.pyc
.env

# Rebuildable. The snapshot is committed; the cache it seeds is not.
data/cache*.db
data/cache*.db-wal
data/cache*.db-shm

# Static AIS dumps run to hundreds of megabytes. Downloaded, never committed.
data/reference/ais_positions.csv
data/reference/ais_*.csv

# This machine's sync client leaves " 2" copies behind; catch those too.
*\ 2.*

# Trained artefacts. Regenerate with `python train.py`.
models/*.pkl
